# Railway Project Token (Settings > Tokens in your Railway project).
# Needs read access to metrics and write access to deployments.
RAILWAY_API_TOKEN=

# Only these services will ever be touched. JSON array, one entry per
# service. Each entry MUST list its Railway regions with a required
# minReplicas per region (your safety floor - never defaulted silently). A
# region that's live on Railway but missing here is left untouched. Any
# other field (maxReplicas, cpuHigh, cpuLow, memHigh, memLow) is optional and
# cascades region -> service -> the global defaults below. Example:
# [
#   {
#     "serviceId": "abc-123",
#     "regions": {
#       "us-west2": { "minReplicas": 1 },
#       "eu-west4-drams3a": { "minReplicas": 2, "maxReplicas": 8, "cpuHigh": 80 }
#     }
#   }
# ]
SCALE_TARGETS=[]

# Global defaults, used unless overridden per-target in SCALE_TARGETS.
MAX_REPLICAS=3
CPU_HIGH=75
CPU_LOW=30
MEM_HIGH=75
MEM_LOW=30

# How often to check metrics, and how long to wait after a scaling event
# before a given service can be scaled again ("a couple of minutes" per
# Railway's own tip on building custom autoscalers).
POLL_INTERVAL_SECONDS=60
COOLDOWN_SECONDS=180

# When true, decisions are logged but never applied. Use this to tune your
# thresholds safely before letting the autoscaler make real changes.
DRY_RUN=false

# "json" prints one structured JSON line per event (good for log
# aggregators, e.g. Railway's own log viewer). "pretty" prints short
# human-readable lines instead (good for watching along locally). If unset,
# this defaults to "pretty" when DRY_RUN=true, and "json" otherwise.
# LOG_FORMAT=pretty

# --- The variables below are auto-injected by Railway on every deployed
# --- service. You do not need to set them yourself when deploying on
# --- Railway; they're only listed here for local development/testing.
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_SERVICE_ID=
